# ==========================================
# POSTGRES CONTAINER CONFIG
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=multitrack_db

# ==========================================
# SPRING BOOT APP CONFIG
# ==========================================
# DB_URL inside docker network uses container name 'multitrack-postgres'
DB_URL=jdbc:postgresql://multitrack-postgres:5432/multitrack_db
DB_USERNAME=postgres
DB_PASSWORD=mysecretpassword
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=86400
PORT=8080
FRONTEND_URL=http://localhost:3000

# ==========================================
# BREVO EMAIL SERVICE CONFIG
# ==========================================
# Brevo API Key (starts with xkeysib-)
BREVO_API_KEY=
# Brevo Sender Email MUST be verified in Brevo Dashboard (e.g. rn100204@gmail.com)
BREVO_SENDER_EMAIL=rn100204@gmail.com
MAIL_FROM=rn100204@gmail.com

# ==========================================
# DEEPSEEK AI EVALUATION SERVICE
# ==========================================
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
